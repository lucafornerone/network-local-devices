  "files": [
    "dist"
  ],
  "dependencies": {
    "network-ip-list": "2.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "chai": "^6.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mocha": "^11.8.0",
    "typescript": "^7.0.2"
